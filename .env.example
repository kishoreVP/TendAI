# Copy to .env and adjust. Never commit .env.

# Storage (defaults: ./storage and SQLite)
# TENDAI_STORAGE_DIR=./storage
# TENDAI_DATABASE_URL=postgresql+psycopg://user:pass@localhost/tendai
# TENDAI_MAX_UPLOAD_MB=50

# Inference: none (rules only, default) | groq | local
TENDAI_DEFAULT_PROVIDER=none
# Per-task routing overrides, e.g. {"requirement_extraction": "groq", "evidence_mapping": "local"}
TENDAI_TASK_ROUTING={}

# Groq (GPT-OSS). Models verified on console.groq.com/docs/models: openai/gpt-oss-120b, openai/gpt-oss-20b
GROQ_API_KEY=
TENDAI_GROQ_MODEL=openai/gpt-oss-120b
# Bidder documents are sent to a cloud API only if this is true
TENDAI_ALLOW_CLOUD_FOR_BIDDER_DOCS=false

# Local OpenAI-compatible server (llama.cpp llama-server on the Jetson Orin Nano)
TENDAI_LOCAL_LLM_URL=http://jetson.local:8080/v1
TENDAI_LOCAL_LLM_MODEL=qwen2.5-3b-instruct-q4_k_m
TENDAI_LLM_TIMEOUT_S=60
